<mxCell id="c28" value="その月の資料は右へ足す" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="832" y="516" width="300" height="80" as="geometry"/></mxCell>
<mxCell id="c29" value="" style="endArrow=block;html=1;strokeColor=#444441;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="620" as="sourcePoint"/><mxPoint x="80" y="670" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="c30" value="新しい月は下に行を足す(置いたカードは動かさない)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="400" height="30" as="geometry"/></mxCell>
<mxCell id="c31" value="色 = 区分(紫 設計・桃 テスト・灰 管理・緑 定例・橙 臨時の会議)。区分のタグが無ければ灰" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1000" height="30" as="geometry"/></mxCell>
<mxCell id="c33" value="&lt;b&gt;時系列型の決まりごと&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;行&lt;/b&gt;&lt;br&gt;1 行 = 1 か月。上が古く、下が新しい&lt;br&gt;資料の無い月も空の行として残す(間隔を崩さない)&lt;br&gt;&lt;br&gt;&lt;b&gt;行の中&lt;/b&gt;&lt;br&gt;日付の早い順に左から右へ&lt;br&gt;日付は 題名・ファイル名の日付 → 無ければ最新版の登録日&lt;br&gt;1 行 7 枚まで。超えたら同じ月の中で次の段へ折り返す&lt;br&gt;&lt;br&gt;&lt;b&gt;カード&lt;/b&gt;&lt;br&gt;1 枚 = 資料の最新版(題名・日付)&lt;br&gt;色は区分のタグで付ける(無くても並ぶ)&lt;br&gt;版の移り変わりを見たいときは、版ごとに置いて線でつなぐ別モデルにする&lt;br&gt;&lt;br&gt;&lt;b&gt;伸び方&lt;/b&gt;&lt;br&gt;資料はその月の行の右へ足す&lt;br&gt;新しい月は下に行を足す&lt;br&gt;置いたカードは動かさない(折り返しで段が増えたときだけ、下の月を下げる)&lt;br&gt;&lt;br&gt;&lt;b&gt;向いているもの&lt;/b&gt;&lt;br&gt;フォルダやタグが整っていないプロジェクト、経緯を追いたいとき" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FAFAF8;strokeColor=#B4B2A9;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1660" y="0" width="440" height="730" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>
</mxfile>

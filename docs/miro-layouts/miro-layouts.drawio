<mxCell id="c28" value="■ (新しいフォルダ)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;fontColor=#B4B2A9;" vertex="1" parent="1"><mxGeometry x="1560" y="70" width="200" height="30" as="geometry"/></mxCell>
<mxCell id="c29" value="フォルダが増えたら右に列を足す" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="1560" y="210" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;b&gt;フォルダ列型の決まりごと&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;列&lt;/b&gt;&lt;br&gt;1 列 = 一番上の階層のフォルダ&lt;br&gt;列の順 = おしながきのフォルダの順&lt;br&gt;列の幅はカード 2 枚分で固定&lt;br&gt;&lt;br&gt;&lt;b&gt;列の中&lt;/b&gt;&lt;br&gt;見出し ■ フォルダ名 の下に、おしながきの順で 2 枚ずつ折り返す&lt;br&gt;下の階層のフォルダは ▼ フォルダ名 の小見出しを入れ、その下に続ける&lt;br&gt;フォルダに入っていない資料は最後の「その他」列へ&lt;br&gt;&lt;br&gt;&lt;b&gt;カード&lt;/b&gt;&lt;br&gt;1 枚 = 資料の最新版(題名・版)&lt;br&gt;&lt;br&gt;&lt;b&gt;伸び方&lt;/b&gt;&lt;br&gt;資料が増えたらその列の下へ足し、枠を下へ伸ばす(枠の上の端は動かさない)&lt;br&gt;フォルダが増えたら右に列を足す&lt;br&gt;列ごとに長さが揃わなくてよい&lt;br&gt;&lt;br&gt;&lt;b&gt;向いているもの&lt;/b&gt;&lt;br&gt;フォルダ分けがそのまま工程や種類になっているプロジェクト。タグを付けなくても並ぶ" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FAFAF8;strokeColor=#B4B2A9;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1840" y="0" width="440" height="520" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>

<mxCell id="c27" value="課題一覧" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#444441;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="710" width="160" height="50" as="geometry"/></mxCell>

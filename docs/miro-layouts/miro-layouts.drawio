<mxCell id="c15" value="要件定義書&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;版 1.3・09/30&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;fontSize=13;" vertex="1" parent="1"><mxGeometry x="810" y="384" width="340" height="66" as="geometry"/></mxCell>
<mxCell id="c16" value="DB 設計&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;版 1.1・09/11&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1F5EE;strokeColor=#0F6E56;fontColor=#085041;fontSize=13;" vertex="1" parent="1"><mxGeometry x="810" y="462" width="340" height="66" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;廃止&lt;/b&gt;　1 件" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontColor=#444441;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1180" y="90" width="360" height="44" as="geometry"/></mxCell>
<mxCell id="c18" value="旧 画面一覧&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;版 1.0・08/01&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B4B2A9;fontColor=#888780;fontSize=13;dashed=1;" vertex="1" parent="1"><mxGeometry x="1190" y="150" width="340" height="66" as="geometry"/></mxCell>
<mxCell id="c19" value="列の中は更新の新しい順に上から。廃止は点線で薄く置く" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#5F5E5A;" vertex="1" parent="1"><mxGeometry x="40" y="562" width="1200" height="30" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;カンバン型の決まりごと&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;列&lt;/b&gt;&lt;br&gt;タグ 状態:作成中 / 状態:レビュー中 / 状態:承認済み / 状態:廃止&lt;br&gt;タグが無い資料は左端の「未設定」列へ(図では省略)&lt;br&gt;列の見出しに件数を出す&lt;br&gt;&lt;br&gt;&lt;b&gt;列の中&lt;/b&gt;&lt;br&gt;最新版の更新の新しい順に上から&lt;br&gt;カードに版と更新日を出す&lt;br&gt;&lt;br&gt;&lt;b&gt;動き方&lt;/b&gt;&lt;br&gt;タグが変わったら、次の連動でカードを移す列の一番上へ動かす&lt;br&gt;このモデルだけは「置いたカードを動かさない」の例外になる&lt;br&gt;承認済みが長くなったら新しい 10 件だけ置き、残りは「ほか n 件」にまとめる&lt;br&gt;&lt;br&gt;&lt;b&gt;向いているもの&lt;/b&gt;&lt;br&gt;レビュー待ちの溜まり具合を見たいとき。レビュー会の画面" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#FAFAF8;strokeColor=#B4B2A9;fontSize=13;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1660" y="0" width="440" height="618" as="geometry"/></mxCell>
</root>
</mxGraphModel>
</diagram>

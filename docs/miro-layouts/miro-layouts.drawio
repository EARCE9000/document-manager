<mxCell id="c17" value="画面一覧&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;140 日前&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F6FE;strokeColor=#AFA9EC;fontColor=#7F77DD;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="360" width="350" height="90" as="geometry"/></mxCell>

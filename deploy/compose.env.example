# compose.env.example : deploy/compose.sh が読み込む設定のひな形
# Copyright(c) 2026 EARCE.NET <d.idei@earce.net>
# MIT Licensed
#
# 使い方: このファイルをコピーして、サーバ上の Git 管理外の場所に置き、実際の値を書く。
#   cp deploy/compose.env.example /etc/application-auth/document-manager.env
#   chmod 600 /etc/application-auth/document-manager.env
#   DOCUMENT_MANAGER_ENV=/etc/application-auth/document-manager.env ./deploy/compose.sh up
#
# 置き場所を省略した場合は /etc/application-auth/document-manager.env を読む。
# 実際の値(ドメイン・内部IP・シークレット等)はここに書き、リポジトリにはコミットしないこと。

# ---- 認証(OIDC) ----
OIDC_ISSUER="https://accounts.example.com"
OIDC_CLIENT_ID="<クライアントID>"
OIDC_CLIENT_SECRET="<クライアントシークレット>"
OIDC_REDIRECT_URI="https://docs.example.com/login"
OIDC_SCOPE="openid profile email"

# adminロールのユーザーが1人もいない場合にだけ働く、ブートストラップ用のメールアドレス
ADMIN_EMAIL="admin@example.com"

# ログインセッションの署名鍵。`openssl rand -hex 32` で生成した値を入れる
# (未設定だと起動のたびにランダム生成され、再起動のたびに全員がログアウトされる)
SESSION_SECRET=""
SESSION_MAX_AGE_HOURS="8"

# ---- 公開の仕方 ----
# リバースプロキシ配下のサブパスで公開する場合はそのパス(例: /document_management)
BASE_PATH="/"
# 既存の外部ネットワーク名と、そこで使うアプリの固定IP
# (リバースプロキシがこのIPを向いている場合、変えないことで設定変更を不要にできる)
DOCUMENT_MANAGER_NETWORK="application_network"
DOCUMENT_MANAGER_IP="10.0.0.2"

# ---- データの置き場所(ホスト側) ----
DOCUMENT_MANAGER_DATA_DIR="/var/lib/document-manager/data"
WEAVIATE_DATA_DIR="/var/lib/document-manager/weaviate"

# ---- イメージ ----
# 切り戻したい場合は日時タグ(例: 20260923_143000)を指定する
DOCUMENT_MANAGER_TAG="latest"
DOCUMENT_MANAGER_CONVERTER_TAG="latest"

# ---- Office文書の体裁つき表示(converter) ----
# Excel/Word/PowerPoint をPDFへ変換して、元の体裁のまま見られるようにする。
# converter を動かさない場合でも、アプリ内蔵の概要プレビューと全文検索は使える。
# 変換対象の上限(バイト)。超えた文書は変換せず、概要プレビューだけで扱う
CONVERT_MAX_BYTES="52428800"
# 1件あたりの変換の打ち切り(秒)
CONVERT_TIMEOUT_SECONDS="120"
# 変換の作業場所(メモリ上の一時領域)の大きさ
CONVERT_TMPFS_SIZE="1g"
# converterコンテナのメモリ上限(実測のピークは約272MB)
CONVERT_MEM_LIMIT="1g"

# モックアップ管理(ビルド済みのWebページ一式をZIPで登録して別ウィンドウで確認する機能)。
# 既定は無効。ここで開けなくても、管理画面の「サーバー」タブから切り替えられる
# MOCKUPS_ENABLED="true"
